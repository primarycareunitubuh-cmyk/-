rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidCampaign(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 500
        && data.code is string && data.code.size() <= 100
        && (!('targetUnit' in data) || (data.targetUnit is string && data.targetUnit.size() <= 500))
        && (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 500))
        && data.status in ['active', 'paused', 'archived']
        && (!('description' in data) || (data.description is string && data.description.size() <= 3000))
        && (!('thankYouMessage' in data) || (data.thankYouMessage is string && data.thankYouMessage.size() <= 2000))
        && (!('welcomeMessage' in data) || (data.welcomeMessage is string && data.welcomeMessage.size() <= 2000))
        && (!('questions' in data) || data.questions is list)
        && (!('criteria' in data) || data.criteria is list)
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 50))
        && (!('endDate' in data) || (data.endDate is string && data.endDate.size() <= 50));
    }

    function isValidSubmission(data) {
      return data.id is string && data.id.size() <= 128
        && data.campaignId is string && data.campaignId.size() <= 128
        && data.submittedAt is string && data.submittedAt.size() <= 50
        && data.overallScorePercent is number
        && data.overallScorePercent >= 0 && data.overallScorePercent <= 100
        && data.answers is map;
    }

    function isValidSetting(data) {
      return data.id is string && data.id.size() <= 128
        && data.value is string && data.value.size() <= 200;
    }

    // Survey Campaigns & Question Sets
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, update: if isValidId(campaignId) && isValidCampaign(incoming());
      allow delete: if isValidId(campaignId);
    }

    // Patient Survey Submissions (Real-time stream)
    match /submissions/{submissionId} {
      allow read: if true;
      allow create: if isValidId(submissionId) && isValidSubmission(incoming());
      allow update: if false; // Immutable historical records
      allow delete: if isValidId(submissionId);
    }

    // Global Settings (Active campaign pointer, etc.)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId) && isValidSetting(incoming());
    }
  }
}
